# ~/.config/systemd/user/ttyd.service — terminal panel transport (DESIGN.md §6).
# Loopback-only + origin check; the SAME credential Caddy injects is enforced here (-c), so
# a direct localhost hit on :7681 still needs auth (DNS-rebinding defense in depth).
# TTYD_CREDENTIAL=user:pass comes from secrets/ttyd.env (never in git).
[Unit]
Description=ttyd terminal panel (attaches to the claude tmux session)
After=claude-tmux.service
Wants=claude-tmux.service

[Service]
EnvironmentFile=/blazing/stack/secrets/ttyd.env
ExecStart=/usr/bin/ttyd -W -i 127.0.0.1 -p 7681 -O -b /claude \
  -c ${TTYD_CREDENTIAL} \
  -t disableLeaveAlert=true -t titleFixed=Claude \
  /usr/bin/tmux new-session -A -s claude '/usr/bin/env claude --continue'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
