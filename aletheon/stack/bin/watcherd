#!/usr/bin/env python3
"""watcherd — frozen-scope core daemon (DESIGN.md §5).

Scope (deny-listed, deliberately small): inotify → per-panel debounce → SSE; POST /signal
(Claude-hook inlet into the SAME debouncer); POST /reload/<panel>; kiosk heartbeat;
read-only GPU/session metrics for dashboard tiles. ALL routing/behavior comes from
Claude-editable data files: state/watch-map.json, state/events.json.
Runs as a lingering user unit (survives graphical-session restarts).
"""
import json
import os
import queue
import subprocess
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

STACK = os.environ.get("ALETHEON_STACK", "/blazing/stack")
BIND = ("127.0.0.1", 8484)
EXCLUDE = (os.path.join(STACK, "jobs"), os.path.join(STACK, "staging"),
           os.path.join(STACK, "secrets"), os.path.join(STACK, ".git"))

clients_lock = threading.Lock()
clients = []            # list[queue.Queue] — one per SSE subscriber
pending_lock = threading.Lock()
pending = {}            # panel -> threading.Timer
last_heartbeat = {"ts": 0.0}


def token():
    try:
        with open(os.path.join(STACK, "secrets", "watcherd-token")) as f:
            return f.read().strip()
    except FileNotFoundError:
        return None


TOKEN = token()


def rules():
    try:
        with open(os.path.join(STACK, "state", "watch-map.json")) as f:
            return json.load(f)["rules"]
    except (OSError, ValueError, KeyError):
        return []


def events_cfg():
    try:
        with open(os.path.join(STACK, "state", "events.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def broadcast(panel, action):
    msg = json.dumps({"panel": panel, "action": action, "ts": time.time()})
    with clients_lock:
        dead = []
        for q in clients:
            try:
                q.put_nowait(msg)
            except queue.Full:
                dead.append(q)
        for q in dead:
            clients.remove(q)
    run_event_actions(panel, action)


def run_event_actions(panel, action):
    """events.json: {"on": [{"panel": "...", "action": "...", "exec": ["argv"...],
    "say": "text"}]} — TTS and future automations are consumers, not features."""
    cfg = events_cfg()
    for rule in cfg.get("on", []):
        if rule.get("panel") in (panel, "*") and rule.get("action") in (action, "*"):
            argv = list(rule.get("exec", []))
            if rule.get("say"):
                say = cfg.get("tts", ["spd-say"])  # default speech-dispatcher; piper via cfg
                argv = say + [rule["say"].replace("{panel}", panel)]
            if argv:
                subprocess.Popen(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def schedule(path):
    """Debounce per panel; Glance gets an extra delay so its own fsnotify reparse
    lands before the iframe reloads (verified ordering requirement)."""
    ap = os.path.realpath(path)
    if any(ap.startswith(e) for e in EXCLUDE):
        return
    for r in sorted(rules(), key=lambda r: -len(r["prefix"])):
        if ap.startswith(os.path.join(STACK, r["prefix"])):
            panel = r["panel"]
            delay = 1.5 + float(r.get("extra_delay", 0))
            action = r.get("sse_action", "reload")
            with pending_lock:
                if panel in pending:
                    pending[panel].cancel()
                t = threading.Timer(delay, lambda p=panel, a=action: fire(p, a))
                pending[panel] = t
                t.start()
            return


def fire(panel, action):
    with pending_lock:
        pending.pop(panel, None)
    broadcast(panel, action)


def inotify_loop():
    watch = [os.path.join(STACK, d) for d in ("shell", "glance", "caddy", "state", "modes")]
    cmd = ["inotifywait", "-m", "-r", "-q", "-e", "close_write,create,moved_to",
           "--format", "%w%f"] + [d for d in watch if os.path.isdir(d)]
    while True:
        try:
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True)
            for line in proc.stdout:
                schedule(line.strip())
            proc.wait()
        except FileNotFoundError:
            print("watcherd: inotifywait not installed; file watching disabled")
            return
        time.sleep(2)  # inotifywait died (e.g. watched dir replaced) — restart it


def gpu_metrics():
    try:
        out = subprocess.run(
            ["nvidia-smi", "--query-gpu=index,name,utilization.gpu,utilization.decoder,"
             "memory.used,memory.total,temperature.gpu,power.draw,pstate",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=5).stdout
        gpus = []
        for line in out.strip().splitlines():
            f = [x.strip() for x in line.split(",")]
            gpus.append({"index": int(f[0]), "name": f[1], "util": f[2], "dec": f[3],
                         "mem_used": f[4], "mem_total": f[5], "temp": f[6],
                         "power": f[7], "pstate": f[8]})
        return {"gpus": gpus}
    except (OSError, subprocess.TimeoutExpired, ValueError, IndexError) as e:
        return {"error": str(e)}


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):  # quiet
        pass

    def _json(self, obj, code=200):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _authed(self):
        if TOKEN is None:
            self._json({"error": "no token provisioned; mutating endpoints disabled"}, 503)
            return False
        if self.headers.get("X-Aletheon-Token") != TOKEN:
            self._json({"error": "forbidden"}, 403)
            return False
        return True

    def do_GET(self):
        if self.path == "/healthz":
            self._json({"ok": True})
        elif self.path == "/metrics/gpu":
            self._json(gpu_metrics())
        elif self.path == "/session":
            self._json({"session_type": os.environ.get("XDG_SESSION_TYPE", "unknown")})
        elif self.path == "/heartbeat/last":
            age = time.time() - last_heartbeat["ts"] if last_heartbeat["ts"] else None
            self._json({"age_seconds": age})
        elif self.path == "/events":
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-cache")
            self.end_headers()
            q = queue.Queue(maxsize=64)
            with clients_lock:
                clients.append(q)
            try:
                while True:
                    try:
                        msg = q.get(timeout=25)
                        self.wfile.write(f"data: {msg}\n\n".encode())
                    except queue.Empty:
                        self.wfile.write(b": keepalive\n\n")
                    self.wfile.flush()
            except (BrokenPipeError, ConnectionResetError):
                pass
            finally:
                with clients_lock:
                    if q in clients:
                        clients.remove(q)
        else:
            self._json({"error": "not found"}, 404)

    def do_POST(self):
        n = int(self.headers.get("Content-Length", 0) or 0)
        raw = self.rfile.read(n) if n else b"{}"
        if self.path == "/heartbeat":
            last_heartbeat["ts"] = time.time()
            self._json({"ok": True})
            return
        if not self._authed():
            return
        if self.path == "/signal":
            try:
                path = json.loads(raw).get("path", "")
            except ValueError:
                self._json({"error": "bad json"}, 400)
                return
            schedule(path)  # hook inlet feeds the SAME debouncer — never a direct emit
            self._json({"ok": True})
        elif self.path.startswith("/reload/"):
            panel = self.path.split("/reload/", 1)[1].strip("/")
            if panel and all(c.isalnum() or c in "-_" for c in panel):
                broadcast(panel, "reload")
                self._json({"ok": True})
            else:
                self._json({"error": "bad panel"}, 400)
        else:
            self._json({"error": "not found"}, 404)


def main():
    threading.Thread(target=inotify_loop, daemon=True).start()
    srv = ThreadingHTTPServer(BIND, Handler)
    print(f"watcherd on {BIND[0]}:{BIND[1]}, stack={STACK}, "
          f"token={'set' if TOKEN else 'MISSING (mutating endpoints disabled)'}")
    srv.serve_forever()


if __name__ == "__main__":
    main()
